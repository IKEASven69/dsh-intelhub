{
  "name": "dsh-deck",
  "version": "0.1.0",
  "description": "dsh 工作台插件：知识调研台 + 自媒体台 + 可新建工作台的容器。文件即协议，zcode 引擎，发布预填人工终审。计划见 PLAN.md。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/link-deps.mjs"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "link:deps": "node scripts/link-deps.mjs",
    "build": "node scripts/link-deps.mjs && tsdown",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
