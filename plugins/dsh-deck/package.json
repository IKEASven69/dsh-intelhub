{
  "name": "dsh-deck",
  "version": "0.2.0",
  "description": "dsh 个人工作台插件：五台一屏（总台/知识库/内容/调研/消息）+ 宿主对话右栏 + PPT 放映 + 双通道派发 + 审阅落库 + 发布预填。本地优先，零云端。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "scripts/link-deps.mjs"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "link:deps": "node scripts/link-deps.mjs",
    "build": "node scripts/link-deps.mjs && tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
